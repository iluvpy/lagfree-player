{
  "manifest_version": 3,
  "name": "LagFree — Smooth YouTube Player",
  "short_name": "LagFree",
  "version": "1.1.0",
  "description": "A lightweight Discord-dark YouTube player that pre-buffers, forces H.264, and caps quality to keep playback smooth.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "LagFree — smooth YouTube player",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "contextMenus",
    "declarativeNetRequestWithHostAccess",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.youtube-nocookie.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "open-lagfree": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Open the current YouTube video in LagFree"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/embed/*",
        "https://www.youtube-nocookie.com/embed/*"
      ],
      "js": [
        "player/codec-guard.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN",
      "css": [
        "player/embed.css"
      ]
    },
    {
      "matches": [
        "https://www.youtube.com/embed/*",
        "https://www.youtube-nocookie.com/embed/*"
      ],
      "js": [
        "player/embed-scope.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "lagfree_referer",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
